// Cloudflare Workers Builds: build command `bash scripts/build-site.sh`,
// deploy command `npx wrangler deploy`. The Worker name must match the
// dashboard project ("portfolio").
{
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only the Supabase proxy runs code; every other request is a static file.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
